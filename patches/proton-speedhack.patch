+
+        # Packs up to 4 keys into a single value to send to the speedhack wine wrapper    
+        def convert_keycodes(key_string):
+            keys  = key_string.split(',')    
+            key_1 =  keycodes.get(keys[0].lower(), 0) if len(keys) > 0 else 0
+            key_2 =  keycodes.get(keys[1].lower(), 0) if len(keys) > 1 else 0
+            key_3 =  keycodes.get(keys[2].lower(), 0) if len(keys) > 2 else 0
+            key_4 =  keycodes.get(keys[3].lower(), 0) if len(keys) > 3 else 0
+
+            return (key_4 << 24) | (key_3 << 16) | (key_2) << 8 | key_1
+
+        def is_float(num):
+            try:
+                float(num)
+            except ValueError:
+                return False
+            
+            return True
+
+        def is_bool(num):
+            return num == "0" or num == "1"
+
+        def read_config_from_file(path):
