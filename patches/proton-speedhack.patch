+                }
+            except:
+                return {}
+
+        def get_first_key(items, key, default):
+            return next((item[key] for item in items if item is not None and key in item and item[key] is not None), default)
+
+        # Order of configs is important, default order is environ, game specific, home specific, finaly relative to proton
+        all_configs = []
+
+        env_configs = {}
+        env_configs['speed'] = self.env["SPEEDHACK_SPEED"] if "SPEEDHACK_SPEED" in self.env and is_float(self.env["SPEEDHACK_SPEED"]) else None
+        env_configs['toggle'] = self.env["SPEEDHACK_TOGGLE"] if "SPEEDHACK_TOGGLE" in self.env and is_bool(self.env["SPEEDHACK_TOGGLE"]) else None
+        env_configs['keys'] = None
+
+        all_configs.append(env_configs)
+
+        # We remove these from the env in case they were invalid
+        if "SPEEDHACK_SPEED" in self.env:
+            del self.env["SPEEDHACK_SPEED"]
+        if "SPEEDHACK_TOGGLE" in self.env:
+            del self.env["SPEEDHACK_TOGGLE"]
+        if "SPEEDHACK_KEYS" in self.env:
+            env_keycodes = convert_keycodes(self.env["SPEEDHACK_KEYS"])
+            if env_keycodes > 0:
+                env_configs['keys'] = str(env_keycodes)
+            del self.env["SPEEDHACK_KEYS"]
+
+        # Load JSON configs into our config files
+        game_config = read_config_from_file('~/.speedhack/' + str(os.environ.get("SteamGameId", 0)) + '.json')
