+/******************************************************************
+ *           wine_update_speedhack_multiplier
+ */
+NTSTATUS WINAPI wine_update_speedhack_multiplier( ULONG multiplier )
+{
+    SERVER_START_REQ( speedhack_set_speed )
+    {
+        req->multiplier  = multiplier;
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+
+    return STATUS_SUCCESS;
+}
+
 
